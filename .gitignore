# === Rust / Cargo 构建产物 ===
# Cargo 编译输出目录，几十 MB 到 GB 级，绝不上传
/target/

# === 阶段 B：runtime 可执行文件 ===
# 决策 6：不 commit 任何 .exe，runtime 属发布产物（Release asset / 安装包）
runtime/
*.exe

# === 本地配置与临时目录 ===
# 敏感配置（API key 等），绝不提交
.env
.env.*
!.env.example

# 冒烟/测试用工作目录
.tmp-ws/

# === 编辑器 / IDE ===
.vscode/
.idea/
*.swp
*.swo

# === 系统杂项 ===
.DS_Store
Thumbs.db
